# Written and updated by the make targets. You rarely need to edit it by hand.

# --- Project (make setup) -----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
# Where Cloud Run and Agent Runtime deploy; change before deploying anything.
REGION=us-central1

# --- Gemini --------------------------------------------------------------------------
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_LOCATION=global
WORKSHOP_MODEL=gemini-3.5-flash
# Module 6: a cheaper model for the three researchers
# WORKSHOP_FAST_MODEL=

# --- Module 1: MCP tool servers on Cloud Run (make deploy-mcp) -------------------------
ORDERS_MCP_URL=
INVENTORY_MCP_URL=
SHIPPING_MCP_URL=

# --- Modules 2-3: Agent Runtime (make deploy-refunds, make deploy-app) ------------------
STAGING_BUCKET=
REFUNDS_RUNTIME_ID=
A2A_AGENT_CARDS=
APP_RUNTIME_ID=

# --- Module 4: guardrails ------------------------------------------------------------
AUTO_REFUND_LIMIT=150
MAX_TOOL_CALLS_PER_TURN=12
MAX_LLM_CALLS_PER_TURN=20

# --- Bonus: RAG Engine (make bonus-rag) ------------------------------------------------
RAG_REGION=europe-west4
RAG_CORPUS=
POLICY_MCP_URL=
